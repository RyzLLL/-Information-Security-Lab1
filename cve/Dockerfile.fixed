# ---------------------------------------------------------------------------
# FIXED build -- Nacos 1.4.1 with the User-Agent whitelist turned OFF.
#
# CVE-2021-29441 is "fixed in 1.4.1" only in the sense that 1.4.1 introduces the
# switch at all. It ships as:
#     nacos.core.auth.enable.userAgentAuthWhite=true
# so the bypass still works on a stock 1.4.1 (verified). The real fix is two
# steps and both are needed:
#     1. upgrade to 1.4.1 (the property exists)
#     2. set nacos.core.auth.enable.userAgentAuthWhite=false
#
# Everything else -- authentication enabled, same base image, same port -- stays
# identical, so the comparison isolates the fix.
# ---------------------------------------------------------------------------
FROM eclipse-temurin:8-jre

LABEL maintainer="lab1-secure-api" \
      description="Nacos 1.4.1 with userAgentAuthWhite disabled (CVE-2021-29441 patched)"

ARG NACOS_VERSION=1.4.1
ARG USER_AGENT_AUTH_WHITE=false

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    curl -fsSL -o /tmp/nacos.tar.gz \
        "https://github.com/alibaba/nacos/releases/download/${NACOS_VERSION}/nacos-server-${NACOS_VERSION}.tar.gz"; \
    mkdir -p /opt; \
    tar -xzf /tmp/nacos.tar.gz -C /opt; \
    rm /tmp/nacos.tar.gz; \
    CONF=/opt/nacos/conf/application.properties; \
    sed -i 's/^nacos.core.auth.enabled=.*/nacos.core.auth.enabled=true/' "$CONF"; \
    if grep -q '^nacos.core.auth.enable.userAgentAuthWhite=' "$CONF"; then \
        sed -i "s/^nacos.core.auth.enable.userAgentAuthWhite=.*/nacos.core.auth.enable.userAgentAuthWhite=${USER_AGENT_AUTH_WHITE}/" "$CONF"; \
    else \
        echo "nacos.core.auth.enable.userAgentAuthWhite=${USER_AGENT_AUTH_WHITE}" >> "$CONF"; \
    fi; \
    grep -q "^nacos.core.auth.enable.userAgentAuthWhite=${USER_AGENT_AUTH_WHITE}$" "$CONF"; \
    # Disabling the User-Agent whitelist makes Nacos demand a server identity
    # for internal calls. Without one it rejects *every* request, including the
    # console, so a usable deployment must configure a secret pair.
    sed -i "s|^nacos.core.auth.server.identity.key=.*|nacos.core.auth.server.identity.key=lab1server|" "$CONF"; \
    sed -i "s|^nacos.core.auth.server.identity.value=.*|nacos.core.auth.server.identity.value=lab1secret|" "$CONF"; \
    grep '^nacos.core.auth' "$CONF"

WORKDIR /opt/nacos
EXPOSE 8848
CMD ["sh", "-c", "/opt/nacos/bin/startup.sh -m standalone && tail -f /opt/nacos/logs/start.out"]
